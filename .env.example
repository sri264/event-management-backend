# ─────────────────────────────────────────────
# EventNest Backend — copy to .env and fill values
# ─────────────────────────────────────────────
NODE_ENV=local
APP_NAME=EventNest
APP_PORT=4000
API_PREFIX=api/v1
TZ=Asia/Kolkata

# Database (MySQL 8+)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=eventnest_db
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MIGRATIONS_RUN=true

# JWT (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Default admin (created by `npm run seed`)
ADMIN_NAME=EventNest Admin
ADMIN_EMAIL=admin@eventnest.com
ADMIN_PASSWORD=change_me
ADMIN_PHONE=9876543210

# CORS / Frontend (comma separated)
CORS_ORIGIN=http://localhost:5180
FRONTEND_URL=http://localhost:5180

# Booking rules
GST_PERCENT=18
CURRENCY=INR

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Security / tooling
ENABLE_SWAGGER=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300

# Mail (optional — leave SMTP_HOST empty to disable emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=EventNest <no-reply@eventnest.com>
